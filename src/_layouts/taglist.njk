---
layout: base.njk
permalink: "/{{ title | slugify }}/"
---

<div class="content">
  <section class="card">
    {%- if show_title -%}
      <h1>{%- if icon -%}{{icon | safe }}&nbsp;{%- endif -%}{{ title }}</h1>
    {%- endif -%}
    {{ content | safe }}
  </section>
  <section class="card">
    <div id="tags">
      <ul>
      {%- for tag in collections.oc_taglist -%}
        <li><a href="/{% if character_config.tag_slug %}{{character_config.tag_slug}}/{% endif %}{{tag | slugify}}">#{{tag}}</a></li>
      {%- endfor -%}
    </ul>
  </section>
</div>