---
layout: base.njk
title: "Home"
---

<div class="content">

  <section class="card">
  {%- if show_title -%}
    <h1>{%- if icon -%}{{icon | safe }}&nbsp;{%- endif -%}{{ title }}</h1>
  {%- endif -%}
    {{ content | safe }}
  </section>
    
  {% if character_config.ocs_per_homepage_row or character_config.ocs_per_homepage_row > 0 %}
    {% if character_config.show_featured %}
      <section class="card">
        <h3 class="content-title">
          Featured
        </h3>
        <ul class="oc-list small">
          {%- for oc in collections.ocs | featured | limit(character_config.ocs_per_homepage_row) -%}
            <li class="oc">
              <a href="{{ oc.url }}" {%- if not character_config.show_name_badges_on_homepage -%} data-tippy-content="{{oc.data.name}}"{%- endif -%}><img src="{{ oc.data.icon }}"></a>
              {% if character_config.show_name_badges_on_homepage %}<a href="{{ oc.url }}" class="character-name-badge">{{ oc.data.name }}</a>{% endif %}
            </li>
          {%- endfor -%}
        </ul>
      </section>
    {% endif %}

    {% if character_config.show_recently_created %}
      <section class="card">
        <h3 class="content-title">
          Recently Created
        </h3>
        <ul class="oc-list small">
          {%- for oc in collections.ocs | created | limit(character_config.ocs_per_homepage_row) -%}
            <li class="oc">
              <a href="{{ oc.url }}" {%- if not character_config.show_name_badges_on_homepage -%} data-tippy-content="{{oc.data.name}}"{%- endif -%}><img src="{{ oc.data.icon }}"></a>
              {% if character_config.show_name_badges_on_homepage %}<a href="{{ oc.url }}" class="character-name-badge">{{ oc.data.name }}</a>{% endif %}
            </li>
          {%- endfor -%}
        </ul>
      </section>
    {% endif %}

    {% if character_config.show_recently_updated %}
      <section class="card">
        <h3 class="content-title">
          Recently Updated
        </h3>
        <ul class="oc-list small">
        {%- for oc in collections.ocs | updated | limit(character_config.ocs_per_homepage_row) -%}
          <li class="oc">
            <a href="{{ oc.url }}" {%- if not character_config.show_name_badges_on_homepage -%} data-tippy-content="{{oc.data.name}}"{%- endif -%}><img src="{{ oc.data.icon }}"></a>
            {% if character_config.show_name_badges_on_homepage %}<a href="{{ oc.url }}" class="character-name-badge">{{ oc.data.name }}</a>{% endif %}
          </li>  
        {%- endfor -%}
        </ul>
      </section>
    {% endif %}
  {% endif %}
</div>


