---
layout: base.njk
title: "Home"
---

<div class="content">

  <section class="card">
  {%- if show_title -%}
    <h1>{%- if icon -%}{{icon | safe }}&nbsp;{%- endif -%}{{ title }}</h1>
  {%- endif -%}
    {{ content | safe }}
  </section>
    
  {% if character_config.ocs_per_homepage_row or character_config.ocs_per_homepage_row > 0 %}
    {% if character_config.show_featured %}
      <section class="card">
        <h3 class="content-title">
          Featured
        </h3>
        <ul class="oc-list small">
          {%- for oc in collections.featured_ocs | limit(character_config.ocs_per_homepage_row) -%}
            <li class="oc"><a href="{{ oc.url }}" title="{{ oc.data.name }}"><img src="{{ oc.data.icon }}"></a></li>
          {%- endfor -%}
        </ul>
      </section>
    {% endif %}

    {% if character_config.show_recently_created %}
      <section class="card">
        <h3 class="content-title">
          Recently Created
        </h3>
        <ul class="oc-list small">
          {%- for oc in collections.oc_tags_by_created[ 'oc' ] | limit(character_config.ocs_per_homepage_row) -%}
            <li class="oc"><a href="{{ oc.url }}" title="{{ oc.data.name }}"><img src="{{ oc.data.icon }}"></a></li>
          {%- endfor -%}
        </ul>
      </section>
    {% endif %}

    {% if character_config.show_recently_updated %}
      <section class="card">
        <h3 class="content-title">
          Recently Updated
        </h3>
        <ul class="oc-list small">
        {%- for oc in collections.oc_tags[ 'oc' ] | limit(character_config.ocs_per_homepage_row) -%}
          <li class="oc"><a href="{{ oc.url }}" title="{{ oc.data.name }}"><img src="{{ oc.data.icon }}"></a></li>  
        {%- endfor -%}
        </ul>
      </section>
    {% endif %}
  {% endif %}
</div>


