---
layout: base.njk
permalink: "{{title | slugify}}/{% if pagination.pageNumber > 0 %}{{ pagination.pageNumber | plus: 1 }}/{% endif %}"
---

<div class="content">
  <section class="card">
    {%- if show_title -%}
      <h1>{%- if icon -%}{{icon | safe }}&nbsp;{%- endif -%}{{ title }}</h1>
    {%- endif -%}
    {{ content | safe }}
  </section>
  <section class="card">
    <div id="stories">
      <ul>
      {%- for story in pagination.items -%}
        <li>
            <div class="story-header content-title"><div><a class="title" href="{{story.url}}">{{story.data.title}}</a>{%- if story.data.author -%}&nbsp;by&nbsp;{%- if story.data.author.url -%}<a href="{{story.data.author.url}}">{%- endif %}{{story.data.author.name}}{%- if story.data.author.url -%}</a>{%- endif %}{%- endif -%}</div><b class="date">{{story.data.date | htmlDateString}}</b></div>
            <div class="story-ocs"><b>Characters:</b>&nbsp;
                {%- for oc in story.data.oc_data -%}
                    <a href="{{oc.url}}" class="oc">{{oc.data.name}}</a>{% if not loop.last %}, {% endif %}
                {%- endfor -%}
            </div>
            {%- if story.data.warnings -%}
            <div class="warnings"><b>Content Warnings:</b>&nbsp;
                {%- for warning in story.data.warnings -%}
                    <span class="warning">{{warning}}</span>{% if not loop.last %}, {% endif %}
                {%- endfor -%}
            </div>
            {%- endif -%}
            <i class="summary">{{story.data.summary}}</i>
        </li>
      {%- endfor -%}
    </ul>
  </section>
  {% if pagination.pageLinks.length > 1 %}
    <nav class="pagination card">
      {% if pagination.previousPageLink %}
        <a class="pagination-item" href="{{ pagination.previousPageHref | url }}" title="Previous Page"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i></a>
      {% else %}
        <span class="pagination-item disabled"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i></span>
      {% endif %}
      <span>
        Page {{ pagination.pageNumber + 1 }} of {{ pagination.pages.length }}
      </span>
      {% if pagination.nextPageLink %}
        <a class="pagination-item" href="{{ pagination.nextPageHref | url }}" title="Next Page"><i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
      {% else %}
        <span class="pagination-item disabled"><i class="fa-solid fa-arrow-right" aria-hidden="true"></i></span>
      {% endif %}
    </nav>
  {% endif %}
</div>