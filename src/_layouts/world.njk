---
layout: base.njk
templateClass: tmpl-home
pagination:
  data: collections.oc_world_pages
  size: 1
  alias: world

permalink: "{% if world_slug %}{{world_slug}}/{% endif %}{{ world.name | slugify }}/{% if world.page > 1 %}{{ world.page }}/{% endif %}"
---

<div class="wrapper">
  <div class="content">
    <h3>World: “{{ world.name }}”</h3>
    <ol class="oc-list large">
    {% for oc in world.ocs %}
        <li class="oc"><a href="/oc/{{ oc.page_url | slugify }}" title="{{ oc.name }} (Updated: {{ oc.updated | htmlDateString }})"><img src="{{ oc.icon }}" alt="{{ oc.name }}"></a></li>
    {% endfor %}
    </ol>
    {% if pagination.pageLinks.length > 1 %}
      <nav class="pagination">
        {% if world.page > 1 %}
          <a class="pagination-item" href="{{ pagination.previousPageHref | url }}">🠈</a>
        {% else %}
          <span class="pagination-item disabled">🠈</span>
        {% endif %}

        {% if world.page < world.pageCount %}
          <a class="pagination-item" href="{{ pagination.nextPageHref | url }}">🠊</a>
        {% else %}
          <span class="pagination-item disabled">🠊</span>
        {% endif %}
      </nav>
    {% endif %}
  </div>
</div>