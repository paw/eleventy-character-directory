---
layout: base.njk
order_type: id
pagination:
  data: collections.oc_tags_by_created
  size: 3
  reverse: false
---

<div class="wrapper home">
  <div class="content">
    {{ content | safe }}
    <ul class="oc-list large">
      {%- for oc in pagination.items -%}
        <li class="oc"><a href="{{ oc.url }}" title="{{ oc.data.name }}"><img src="{{ oc.data.icon }}"></a></li>
      {%- endfor -%}
    </ul>
    {% if pagination.pageLinks.length > 1 %}
      <nav class="pagination">
        {% if pagination.previousPageLink %}
          <a class="pagination-item" href="{{ pagination.previousPageHref | url }}">🠈</a>
        {% else %}
          <span class="pagination-item disabled">🠈</span>
        {% endif %}

        {% if pagination.nextPageLink %}
          <a class="pagination-item" href="{{ pagination.nextPageHref | url }}">🠊</a>
        {% else %}
          <span class="pagination-item disabled">🠊</span>
        {% endif %}
      </nav>
    {% endif %}
  </div>
</div>