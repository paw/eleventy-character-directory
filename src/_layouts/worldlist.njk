---
layout: base.njk
permalink: "/{{ title | slugify }}/"
---

<div class="content">
  <section class="card">
    {%- if show_title -%}
      <h1>{%- if icon -%}{{icon | safe }}&nbsp;{%- endif -%}{{ title }}</h1>
    {%- endif -%}
    {{ content | safe }}
  </section>
  <section class="card">
    <div id="worlds">
      <ul>
      {%- for world in collections.ocWorldsList -%}
        <li><a href="/{% if character_config.world_slug %}{{character_config.world_slug}}/{% endif %}{{world.name | slugify}}">{{world.name}}</a> ({{world.ocs.length}} Character{%- if world.ocs.length > 1 -%}s{%-endif-%})</li>
      {%- endfor -%}
    </ul>
  </section>
</div>