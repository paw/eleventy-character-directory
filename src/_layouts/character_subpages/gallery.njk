<nav class="card subpages" aria-label="Character Sub-Pages">
<ul>
<li><a href="../">Overview</a></li>
<li>{%- if (page.oc.data.friends and page.oc.data.friends.length > 0) or (page.oc.data.enemies and page.oc.data.enemies.length > 0) or (page.oc.data.connections) %}<a href="../relationships">Relationships</a>{%- else -%}<span class="disabled" aria-disabled="true">Relationships</span>{%- endif -%}</li>
<li><span class="active" aria-current="page">Gallery</span></li>
</nav>

  <div id="gallery-wrapper">
    <div class="card">
      <h3 class="content-title">
        {{ page.oc.data.name }}{{ "'" if page.oc.data.name.endsWith("s") else "'s" }} Gallery
      </h3>
      <div id="gallery-loading" class="loading"><i class="fa-solid fa-spinner" aria-label="Loading..."></i></div>
      <ul class="masonry-gallery waiting" id="gallery">
        {% for image in page.oc.data.gallery %}
          <li>
          <img src="{%if image.thumb_url != null %}{{image.thumb_url}}{% else %}{{image.full_url}}{% endif %}" class="lightbox-thumb" data-full="{{image.full_url}}" data-data-tippy-content="{{image.title | safe}}" data-title="{{image.title | safe}}" data-caption="{{image.description | safe}}" {%- if image.credit -%}data-credit-name="{{ image.credit }}"{%- endif -%} {%- if image.credit_url -%}data-credit-url="{{ image.credit_url }}"{%- endif -%} data-index="{{ loop.index0 }}" alt="{{image.alt}}" aria-role="button" data-tippy-content="View Full Image" tabindex="0">
          </li>
        {% endfor %}
      </ul>
    </div>

    <div class="lightbox" id="lightbox">
      <button class="lightbox-close" type="button" aria-label="Close" ><i class="fa-sharp-duotone fa-solid fa-circle-xmark" aria-hidden="true"></i></button>
      <button class="lightbox-arrow lightbox-prev" type="button" aria-label="Previous image" ><i class="fa-sharp fa-solid fa-chevron-left" aria-hidden="true"></i></button>
      <div class="lightbox-wrapper" tabindex="-1">
        <div class="lightbox-content-wrapper">
          <figure class="lightbox-figure">
              <div class="lightbox-image-wrap"><img id="lightbox-image" src="" alt=""></div>
              <figcaption>
                  <div class="figcaption-inner">
                      <h2  id="detail-header" class="fig-title">Details:</h2>
                    <h3 id="lightbox-title"></h3>
                    <div id="lightbox-caption"></div>
                    <h2 class="fig-title" id="credit-header">Credit:</h2>
                    <div id="img-credit"></div>
                    <span id="lightbox-counter" aria-live="polite"></span>
                  </div>
              </figcaption>
          </figure>
        </div>
      </div>
      <button class="lightbox-arrow lightbox-next" type="button" aria-label="Next image" ><i class="fa-sharp fa-solid fa-chevron-right" aria-hidden="true"></i></button>
    </div>

  </div>
