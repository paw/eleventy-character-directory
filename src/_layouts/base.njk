# CUSTOMIZE SOME STUFF HERE

limit: 5

---

{# This is the base template for the site–other templates extend this one #}

<!DOCTYPE html>
<html lang="en">
  <head>
    {%if title %}
    <title>{{ character_config.site_title }} - {{ title }}</title>
    {% elif name %}
    <title>{{ character_config.site_title }} - {{ name }}</title>
    {% else %}
    <title>{{ character_config.site_title }}</title>
    {% endif %}
    <meta charset="utf-8" />
    <link rel="icon" href="https://glitch.com/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {% if page_description %}<meta name="description" content="{{ description }}" />{% endif %}
    <link rel="stylesheet" type="text/css" href="/public/css/{{character_config.main_css_file}}.css" />
    <script src="/public/js/main.js" ></script>
    <link rel="stylesheet" href="https://use.fontawesome.com/releases/v7.3.1/css/all.css" crossorigin="anonymous">
    <script src="https://unpkg.com/@popperjs/core@2"></script>
    <script src="https://unpkg.com/tippy.js@6"></script>
    <link rel="stylesheet" href="https://unpkg.com/tippy.js@6/animations/perspective.css"/>
  </head>
  <body>
  <main>
    
    <nav id="navbar" class="nav">
        <span class="title">{%- if character_config.site_title_icon -%}<i class="{{ character_config.site_title_icon }}" aria-hidden="true"></i>&nbsp;{%- endif -%}{{ character_config.site_title | safe }}</span>
        <button class="toggle" data-menu="closed" aria-label="Show Site Navigation"><i class="fa-solid fa-bars closed"></i><i class="fa-solid fa-xmark open"></i></button>
        <div class="links">
          <a href="/"><i class="fa-solid fa-house" aria-hidden="true"></i> Home</a>
          <a href="/{{ character_config.base_directory | slugify }}"><i class="{{ character_config.base_directory_icon }}" aria-hidden="true"></i> {{ character_config.base_directory }}</a>
         {%- for link in collections.navigation -%}
          {% if link.data.permalink != false %}<a href="{{link.url}}">{% if link.data.icon %}{{ link.data.icon | safe }} {% endif %}{{link.data.title}}</a>{% endif %}
         {%- endfor -%}
        </div>
      </nav>
  
  <div id="wrapper">
    {{ content | safe }}
  </div>
      

      <footer class="footer">
      &copy;
      </footer>
    
  </main>
   
  </body>
</html>