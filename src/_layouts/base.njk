---

{# This is the base template for the site–other templates extend this one #}

<!DOCTYPE html>
<html lang="en">
  <head>
    {%if title %}
    <title>{{ character_config.site_title }} - {{ title }}</title>
    {% elif name %}
    <title>{{ character_config.site_title }} - {{ name }}</title>
    {% else %}
    <title>{{ character_config.site_title }}</title>
    {% endif %}
    <meta charset="utf-8" />
    <link rel="icon" href="https://glitch.com/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {% if page_description %}<meta name="description" content="{{ description }}" />{% endif %}
    <link rel="stylesheet" type="text/css" href="/public/css/global.css" />
    <link rel="stylesheet" type="text/css" href="/public/css/{{character_config.main_theme_css_file}}.css" />
    <script src="/public/js/main.js" ></script>
    {%- if character_config.enable_theme_selector -%}<script src="/public/js/theme-toggle.js" ></script>{%- endif -%}
    <link rel="stylesheet" href="https://use.fontawesome.com/releases/v7.3.1/css/all.css" crossorigin="anonymous">
    <script src="https://unpkg.com/@popperjs/core@2"></script>
    <script src="https://unpkg.com/tippy.js@6"></script>
    <link rel="stylesheet" href="https://unpkg.com/tippy.js@6/animations/perspective.css"/>
  </head>
  <body>
  <main>

    <nav id="navbar" class="nav">
        <span class="title">{%- if character_config.site_title_icon -%}{{ character_config.site_title_icon | safe }}&nbsp;{%- endif -%}{{ character_config.site_title | safe }}</span>
        <button class="toggle" id="mobile-menu" data-menu="closed" aria-label="Show Site Navigation"><i class="fa-solid fa-bars closed"></i><i class="fa-solid fa-xmark open"></i></button>
        <div class="links">
            <a href="/">{%- if character_config.nav_home_icon -%}{{ character_config.nav_home_icon | safe }}&nbsp;{%- endif -%} Home</a>
            <a href="/{{ character_config.base_directory | slugify }}">{%- if character_config.nav_base_directory_icon -%}{{ character_config.nav_base_directory_icon | safe }}&nbsp;{%- endif -%}{{ character_config.base_directory }}</a>
         {%- for link in collections.navigation -%}
          {% if link.data.permalink != false %}<a href="{{link.url}}">{% if link.data.icon %}{{ link.data.icon | safe }} {% endif %}{{link.data.title}}</a>{% endif %}
         {%- endfor -%}
        </div>
      </nav>

  <div id="wrapper">
    {{ content | safe }}
  </div>


      <footer class="footer">
          <span class="footer-text">{{character_config.site_footer_text | safe}}</span>
          {%- if character_config.enable_theme_selector -%}<button class="toggle" id="theme-toggle" aria-label="Toggle Theme"><i class="fa-solid fa-circle-half-stroke auto" data-tippy-content="Theme: Auto"></i><i class="fa-solid fa-moon dark" data-tippy-content="Theme: Dark"></i><i class="fa-solid fa-sun light" data-tippy-content="Theme: Light"></i></button>{%- endif -%}
      </footer>

  </main>

  </body>
</html>
