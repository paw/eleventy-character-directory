---
site_title: "Site Title Here"
site_title_icon: fa-solid fa-book-atlas

# CUSTOMIZE SOME STUFF HERE

limit: 5


# permalink generation settings
stories_slug: s
world_slug: w
tag_slug: t
character_slug: c

---

{# This is the base template for the site–other templates extend this one #}

<!DOCTYPE html>
<html lang="en">
  <head>
    {%if title %}
    <title>{{ site_title }} - {{ title }}</title>
    {% elif name %}
    <title>{{ site_title }} - {{ name }}</title>
    {% else %}
    <title>{{ site_title }}</title>
    {% endif %}
    <meta charset="utf-8" />
    <link rel="icon" href="https://glitch.com/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {% if page_description %}<meta name="description" content="{{ description }}" />{% endif %}
    <link rel="stylesheet" type="text/css" href="/public/css/global.css" />
    <script src="/public/js/main.js" ></script>
    <link rel="stylesheet" href="https://use.fontawesome.com/releases/v7.3.1/css/all.css" crossorigin="anonymous">
  </head>
  <body>
  <main>
    
    <nav id="navbar" class="nav">
        <span class="title"><i class="{{ site_title_icon }}" aria-hidden="true"></i> {{ site_title }}</span>
        <div class="links">
          <a href="/"><i class="fa-solid fa-house" aria-hidden="true"></i> Home</a>
          <a href="/{{ character_config.base_directory | slugify }}"><i class="fa-solid fa-users" aria-hidden="true"></i> Directory</a>
         {%- for link in collections.navigation -%}
          <a href="{{link.url}}">{{link.data.title}}</a>
         {%- endfor -%}
        </div>
      </nav>
  
  <div id="wrapper">
    {{ content | safe }}
  </div>
      

      <footer class="footer">
      &copy;
      </footer>
    
  </main>
   
  </body>
</html>